# =============================================================================
# Picox — backend
# Copiare in `backend/.env` (git-ignored) e compilare.
# Il backend legge anche il `.env` di root del monorepo: i valori definiti qui
# hanno la precedenza.
# =============================================================================

# --- Ambiente ----------------------------------------------------------------
# `production` disattiva /docs, /redoc e /openapi.json.
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# BYPASSA IL ROW LEVEL SECURITY. Solo server, mai nel browser.
SUPABASE_SERVICE_ROLE_KEY=

# Verifica del JWT utente. Due modalità alternative:
#   - progetti con JWT secret legacy: valorizzare SUPABASE_JWT_SECRET (HS256)
#     -> Dashboard > Project Settings > API > JWT Settings > JWT Secret
#   - progetti con signing key asimmetrica: lasciare vuoto. Le chiavi pubbliche
#     vengono lette da <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=

# --- Gemini ------------------------------------------------------------------
GEMINI_API_KEY=
# Alias mantenuto da Google sul modello flash correntemente consigliato: evita
# che un ritiro del modello fermi le analisi. Allineato a `render.yaml`, che
# usava già questo valore mentre qui restava `gemini-2.5-flash` — due default
# diversi fra sviluppo e produzione, cioè la differenza che non si nota finché
# non produce un comportamento diverso solo su una delle due.
GEMINI_MODEL=gemini-flash-latest
# Frame al secondo campionati dal modello: è la leva più diretta sui token,
# perché ogni frame è tokenizzato una volta (costo lineare). Il primo valore vale
# per le analisi che guardano il montaggio (STYLE, BOTH), il secondo per quelle
# che guardano solo il contenuto (INFO).
# NON scendere sotto 0.3-0.5 sullo short-form: i tagli rapidi di Reel, Shorts e
# TikTok diventano invisibili a campionamenti più radi.
GEMINI_VIDEO_FPS=1.0
GEMINI_VIDEO_FPS_RIDOTTO=0.5

# --- Apify -------------------------------------------------------------------
APIFY_API_TOKEN=
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper
APIFY_YOUTUBE_ACTOR=streamers/youtube-scraper
APIFY_RESULTS_PER_CREATOR=10
# Actor del *profilo*, usato dalla validazione dei creator: quello dei post non
# espone `isPrivate`, che è il campo su cui la verifica decide.
APIFY_INSTAGRAM_PROFILE_ACTOR=apify/instagram-profile-scraper

# --- YouTube Data API v3 -----------------------------------------------------
# Solo per verificare che un canale esista (`channels.list`): lo scraping dei
# video resta su Apify. FACOLTATIVA — senza, Instagram e TikTok si validano
# normalmente e la sola validazione YouTube risponde 503.
# Google Cloud Console -> API e servizi -> Credenziali -> Chiave API, con
# "YouTube Data API v3" abilitata sul progetto. Conviene restringerla a quella
# sola API: la quota è di 10.000 unità al giorno per progetto e una verifica ne
# consuma 1.
YOUTUBE_API_KEY=

# --- Validazione dei creator -------------------------------------------------
# Quanto resta valida una riga di `creator_validations` prima di rivalidare.
# Alzarlo riduce la spesa esterna e rende più vecchio il dato mostrato: un
# profilo passato a privato resta visto come pubblico al più per questa durata.
CREATOR_VALIDATION_TTL_HOURS=24

# --- Applicazione ------------------------------------------------------------
# Unico origin ammesso dal CORS.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Segreto dell'header X-CRON-SECRET. Stringa random lunga.
CRON_SECRET=

# --- Limiti di ingestione ----------------------------------------------------
# Oltre questi valori l'analisi viene rifiutata con 422.
MAX_VIDEO_MB=200
MAX_VIDEO_DURATION_SECONDS=600
CRON_MAX_CONCURRENT_ANALYSES=2
