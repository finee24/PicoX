# =============================================================================
# Picox — backend
# Copiare in `backend/.env` (git-ignored) e compilare.
# Il backend legge anche il `.env` di root del monorepo: i valori definiti qui
# hanno la precedenza.
# =============================================================================

# --- Ambiente ----------------------------------------------------------------
# `production` disattiva /docs, /redoc e /openapi.json.
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# BYPASSA IL ROW LEVEL SECURITY. Solo server, mai nel browser.
SUPABASE_SERVICE_ROLE_KEY=

# Verifica del JWT utente. Due modalità alternative:
#   - progetti con JWT secret legacy: valorizzare SUPABASE_JWT_SECRET (HS256)
#     -> Dashboard > Project Settings > API > JWT Settings > JWT Secret
#   - progetti con signing key asimmetrica: lasciare vuoto. Le chiavi pubbliche
#     vengono lette da <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=

# --- Gemini ------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Apify -------------------------------------------------------------------
APIFY_API_TOKEN=
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper
APIFY_YOUTUBE_ACTOR=streamers/youtube-scraper
APIFY_RESULTS_PER_CREATOR=10

# --- Applicazione ------------------------------------------------------------
# Unico origin ammesso dal CORS.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Segreto dell'header X-CRON-SECRET. Stringa random lunga.
CRON_SECRET=

# --- Limiti di ingestione ----------------------------------------------------
# Oltre questi valori l'analisi viene rifiutata con 422.
MAX_VIDEO_MB=200
MAX_VIDEO_DURATION_SECONDS=600
CRON_MAX_CONCURRENT_ANALYSES=2
