# ---- Secrets ----------------------------------------------------------------
.env
.env.*
!.env.example

# ---- Log --------------------------------------------------------------------
# Non è una questione di rumore: a livello DEBUG le librerie HTTP/2 (hpack)
# stampano ogni header della richiesta, `apikey` compresa. Un backend.log
# committato equivale a pubblicare la service_role key — è già successo una
# volta su questo progetto.
*.log

# ---- Node / frontend --------------------------------------------------------
node_modules/
.pnpm-store/
dist/
build/
.next/
out/
*.tsbuildinfo
.turbo/
.vercel/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Python / backend -------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ---- Supabase CLI -----------------------------------------------------------
supabase/.temp/
supabase/.branches/

# ---- Claude Code ------------------------------------------------------------
