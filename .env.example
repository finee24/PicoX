# =============================================================================
# Picox — Template variabili d'ambiente
# Copiare in `.env` (git-ignored) e compilare. Non committare mai i valori reali.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------

# URL del progetto, es. https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Chiave pubblica. Soggetta a RLS: può essere esposta al client.
SUPABASE_ANON_KEY=

# Chiave privilegiata: BYPASSA IL ROW LEVEL SECURITY.
# Solo backend/server. Non esporla mai al browser (niente NEXT_PUBLIC_/VITE_).
# Ogni query fatta con questa chiave deve filtrare manualmente su user_id.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Servizi esterni
# -----------------------------------------------------------------------------

# Google AI Studio — analisi multimodale dei video
GEMINI_API_KEY=

# Apify — scraping di Instagram / TikTok / YouTube Shorts
APIFY_API_TOKEN=

# -----------------------------------------------------------------------------
# Applicazione
# -----------------------------------------------------------------------------

# Origin del frontend (CORS, redirect OAuth), es. http://localhost:3000
FRONTEND_URL=

# Base URL del backend chiamato dal frontend, es. http://localhost:8000
BACKEND_URL=

# Segreto condiviso per autenticare le chiamate agli endpoint cron/scheduler.
# Il backend lo legge dall'header `X-CRON-SECRET: $CRON_SECRET`. Stringa random lunga.
CRON_SECRET=

# Verifica del JWT utente lato backend (opzionale, vedi backend/.env.example):
# valorizzare solo per i progetti con JWT secret legacy HS256. Lasciando vuoto,
# le chiavi pubbliche vengono lette dal JWKS del progetto.
SUPABASE_JWT_SECRET=
