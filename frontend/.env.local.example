# =============================================================================
# Picox — frontend
# Copiare in `.env.local` (git-ignored) e compilare.
# =============================================================================
#
# REGOLA: qui possono stare SOLO variabili `NEXT_PUBLIC_*`, e solo queste quattro.
# Next.js inlinea ogni `NEXT_PUBLIC_*` nel bundle JavaScript servito al browser:
# qualunque altra variabile aggiunta con quel prefisso diventa pubblica.
#
# Non devono MAI comparire in questo file né in `.env.local`:
#   SUPABASE_SERVICE_ROLE_KEY, GEMINI_API_KEY, APIFY_API_TOKEN, CRON_SECRET
# Vivono solo nel backend.

# URL del progetto Supabase, es. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chiave pubblica (anon). Soggetta a RLS: è progettata per stare nel browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL del backend FastAPI.
# Deve corrispondere a ciò che il backend accetta in CORS (FRONTEND_URL lato
# backend deve puntare a questo frontend, di default http://localhost:3000).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Sitekey del widget Turnstile sul form di registrazione. E' pubblica per
# progetto: sta nell'HTML di chiunque apra la pagina.
# Il valore qui sotto e' la sitekey di TEST di Cloudflare, che passa sempre e
# ovunque, localhost incluso: va bene per lo sviluppo, va sostituita con quella
# reale in produzione. Attenzione a cosa si vede con la chiave di test, che
# sono due cose diverse: al PRIMO render non disegna nulla — riempie subito il
# token fittizio XXXX.DUMMY.TOKEN.XXXX e lascia uno spazio vuoto nel form —
# mentre DOPO UN RESET (cioe' dopo un tentativo di invio) disegna per qualche
# istante il box Cloudflare con la scritta "Solo per test". Entrambi sono
# comportamenti attesi, non un montaggio fallito.
# La meta' che conta — la secret con cui si verifica il token — non vive in
# questo repo: il signup non passa dal backend di Picox, e la verifica la fa
# Supabase Auth, configurata dalla sua dashboard.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
